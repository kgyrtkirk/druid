# Packs every module's compiler output (classes, test-classes, generated sources, maven-status) into <out>.
# Unpack with tar -m after checkout: sources newer than their classes are recompiled.
#
# Usage: pack_build_output <out>

set -euo pipefail

find . -type d -regextype posix-extended -regex '.*/target/(classes|test-classes|generated-[a-z-]+|maven-status)' -prune -print0 |
  tar --null --zstd -cf "$1" -T -
